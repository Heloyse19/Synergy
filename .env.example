# Copie para .env e ajuste os valores. Nunca versione o .env!

# Banco de dados MySQL 8 (o docker-compose.yml sobe um localmente).
# Em desenvolvimento usamos root para que o Prisma crie o "shadow database" nas migrações.
DATABASE_URL="mysql://root:root@localhost:3306/synergy"

# Segredo usado para assinar o cookie de sessão (JWT HS256). Mínimo 32 caracteres.
# Gere um valor seguro com: openssl rand -base64 32
SESSION_SECRET="troque-este-valor-por-um-segredo-com-32-caracteres-ou-mais"

# URL pública da aplicação (usada em links absolutos e metadados).
APP_URL="http://localhost:3000"

# Cloudflare Turnstile (proteção contra bots nos formulários de login/cadastro).
# Deixe vazio para desativar em desenvolvimento.
# Chaves de TESTE oficiais da Cloudflare (sempre aprovam):
#   TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Senha do usuário administrador criado pelo seed (admin@synergy.local).
SEED_ADMIN_PASSWORD="Admin@123"
