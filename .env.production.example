# Variáveis de PRODUÇÃO lidas pelo docker-compose.prod.yml.
# No servidor: copie para /opt/synergy/.env, preencha e rode `chmod 600 .env`. Nunca versione o .env!

# --- Banco de dados (MySQL 8) ---
# As senhas do MySQL entram na DATABASE_URL, então use apenas letras e números.
# Gere cada uma com: openssl rand -hex 32   (não use base64 aqui: "/" quebra a URL de conexão)
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
# Opcionais (padrão: synergy / synergy)
# MYSQL_USER="synergy"
# MYSQL_DATABASE="synergy"

# --- Aplicação ---
# Segredo que assina o cookie de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 32
SESSION_SECRET=""
# URL pública, com https e sem barra no final.
APP_URL="https://synergy.seudominio.com.br"
# Mostra as contas de demonstração na tela de login. Mantenha false em produção.
SHOW_DEMO_ACCOUNTS="false"
# Opcional: fixa uma versão da imagem (rollback), ex.: ghcr.io/synergy-pi/synergy:sha-abc1234
# APP_IMAGE="ghcr.io/synergy-pi/synergy:latest"

# --- Cloudflare ---
# Token do túnel: Zero Trust → Networks → Tunnels → (seu túnel) → a parte depois de `--token`.
CLOUDFLARE_TUNNEL_TOKEN=""
# Turnstile (login/cadastro). Vazio = a aplicação não exige o desafio.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Licitações (PNCP) ---
# Identificação enviada à API oficial do PNCP, ex.: "Synergy/1.0 (+https://synergy.seudominio.com.br)". Opcional.
PNCP_USER_AGENT=""
